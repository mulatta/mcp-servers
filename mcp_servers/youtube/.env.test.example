# Copy to .env.test (git-ignored). bun test loads it; the setup script reads
# it with --env-file. Values here identify accounts: never commit them.

# Test browser: a rootless podman Neko that `bun run live:setup` manages.
# Every port binds to 127.0.0.1; change any that collide on this host.
YOUTUBE_LIVE_NEKO_NAME=neko-yt-test
YOUTUBE_LIVE_NEKO_CDP_PORT=9224
YOUTUBE_LIVE_NEKO_UI_PORT=8083
YOUTUBE_LIVE_NEKO_MEDIA_PORT=59224
# Browser profile; defaults to $XDG_DATA_HOME/youtube-mcp/live-neko.
# YOUTUBE_LIVE_NEKO_DATA_DIR=

# Browser the live tests drive; defaults to the test browser above.
# YOUTUBE_LIVE_CDP_URL=http://127.0.0.1:9224

# Channel ID of the test account. `live:setup check` writes it.
YOUTUBE_LIVE_ACCOUNT_ID=
# Channel ID of your own account. Setup and every live write refuse it.
YOUTUBE_LIVE_PERSONAL_ACCOUNT_ID=
