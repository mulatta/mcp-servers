# Copy to .env.test (git-ignored). Values here identify accounts: never
# commit them. The live checks change the test account, never another.

# Origin of the Stalwart HTTP listener.
PIM_LIVE_SERVER_URL=https://mail.example.org
# Login name of the test account, as the JMAP session reports it.
PIM_LIVE_ACCOUNT=
# Its address; the end-to-end run sends from it.
PIM_LIVE_ADDRESS=
# Address of a second test account that receives the run's mail.
PIM_LIVE_FRIEND=
# Login name of your own account. Login and every run refuse it.
PIM_LIVE_PERSONAL_ACCOUNT=
# Token directory for the test account; defaults to
# $XDG_STATE_HOME/pim-mcp/live.
# PIM_LIVE_STATE_DIR=
