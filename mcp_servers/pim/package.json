{
  "name": "pim-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "start": "bun run src/index.ts",
    "login": "bun run src/index.ts login",
    "test": "bun test tests/protocol",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run format:check",
    "live:login": "bun --env-file=.env.test tests/live/run.ts login",
    "live:test": "bun --env-file=.env.test tests/live/run.ts test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
